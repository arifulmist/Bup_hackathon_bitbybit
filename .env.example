# LLM provider to use (e.g. openai, gemini, anthropic)
LLM_PROVIDER=openai

# API key for the chosen LLM provider (keep secret, never commit)
LLM_API_KEY=your_llm_api_key_here

# Base URL for custom OpenAI-compatible router (e.g. https://router.bynara.id/v1 or leave empty for official OpenAI)
LLM_BASE_URL=

# Model identifier for operator note interpretation (e.g. gpt-4o-mini or agnes-2.5-flash)
LLM_MODEL=gpt-4o-mini

# Port for the web service to listen on (default 8000)
PORT=8000

# Per-request timeout budget in seconds (default 25s, must stay under 30s limit)
REQUEST_TIMEOUT_SECONDS=25.0

# Maximum retry attempts on LLM call failure before falling back to safe no_op (default 1)
MAX_LLM_RETRIES=1

# Optional Supabase URL for persistent telemetry and operator dashboard
SUPABASE_URL=https://your-project.supabase.co

# Optional Supabase Anon/Publishable Key for client-side/telemetry queries
SUPABASE_ANON_KEY=your_supabase_anon_key_here
